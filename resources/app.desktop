[Desktop Entry]
Name=CodexBar
Comment=AI usage from CodexBar for Linux in the COSMIC™ panel
Type=Application
Icon=io.github.leonardo_panseri.cosmic-ext-applet-codexbar
Exec=cosmic-ext-applet-codexbar
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC;AI;Usage;Quota;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
